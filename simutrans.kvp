Meta.DisplayName=Simutrans (TeamKit)
Meta.Description=Serveur dedie Simutrans, le jeu de transport libre et gratuit (trains, bus, bateaux, avions). Version 125.0.1, serveur compile sans affichage depuis les sources officielles, pakset pak64 ou pak128 au choix. Un seul port TCP, 13353. La partie est sauvegardee a chaque arret et reprise au demarrage ; pour une grande carte, cree-la dans ton jeu et depose la sauvegarde dans save/.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Simutrans
Meta.DisplayImageSource=steam:434520
Meta.EndpointURIFormat=
Meta.ConfigManifest=simutransconfig.json
Meta.MetaConfigManifest=simutransmetaconfig.json
Meta.ConfigRoot=simutrans.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Le serveur Simutrans sans affichage n'est pas publie tout fait : il est compile a l'Update depuis les sources officielles, avec le compilateur et les bibliotheques installes dans le conteneur par ExtraContainerPackages.
Meta.ExtraSetupStepsURI=https://github.com/hydrocut/AMPTemplates-Simutrans#readme
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["g++","make","pkg-config","libpng-dev","zlib1g-dev","libbz2-dev","libzstd-dev","curl","unzip"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=5aa3dcf4-ea74-4ec8-905b-48b8699ea608
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Simutrans
App.RootDir=./simutrans/
App.BaseDirectory=./simutrans/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=simutrans
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs="{{$FullBaseDir}}simutrans/lancer.sh" {{$GamePort}} "{{Pakset}}" "{{Langue}}" "{{PartieDepart}}"
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat={0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[simutransports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=True
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=0
App.RCONConnectRetrySeconds=0
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJson[simutransupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.sve","*.tab","*.txt","*.xml","*.net",".teamkit-*"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(?:Message: (?:packet_t::send:\s+sent \d+ bytes|network_command_t::rdwr:\s+(?:write|read) packet_id=NWC_(?:STEP|CHECK),|karte_t::reset_timer\(\):)|Warning: karte_t:::do_network_world_command:\s+sync_step=).*$
Console.AppReadyRegex=^Message: simu_main\(\):\s+Running world, pause=\d, fast forward=\d \.\.\.\s*$
Console.UserJoinRegex=^Message: __ChatLog__:\s+connect,(?<userid>\d+),[^,]*,(?<username>.+)$
Console.UserLeaveRegex=^Message: __ChatLog__:\s+disconnect,(?<userid>\d+),[^,]*,(?<username>.+)$
Console.UserChatRegex=^Message: __ChatLog__:\s+chat,\d+,[^,]*,(?!Server#)(?<username>"(?:[^"]|"")*"|[^,"]+),\d+,(?:"(?:[^"]|"")*"|[^,"]*),(?<message>.+)$
Console.UpdateAvailableRegex=
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
